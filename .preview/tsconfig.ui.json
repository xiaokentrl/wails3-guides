{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false
  },
  "include": ["../ui/lib/**/*.ts", "../ui/components/**/*.tsx", "../ui/business/**/*.tsx", "../ui/tokens/**/*.ts", "../ui/integrations/**/*.tsx", "../ui/playground/**/*.tsx", "types.d.ts"]
}
